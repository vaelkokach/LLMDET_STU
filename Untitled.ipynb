   "source": [
    "import zipfile\n",
    "from pathlib import Path\n",
    "\n",
    "zip_file = Path(\"Frames.zip\")  # zip file in the same directory\n",
    "\n",
    "with zipfile.ZipFile(zip_file, 'r') as zip_ref:\n",
    "    zip_ref.extractall(zip_file.parent)\n",
    "\n",
    "print(\"Unzipping completed.\")\n"
   ]
